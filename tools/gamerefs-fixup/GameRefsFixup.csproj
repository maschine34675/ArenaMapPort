<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GameRefsFixup</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local, read-only reference — D:/SPT41 is a read-only source (O4/O8), never written to.
         Mono.Cecil ships with every BepInEx install; no NuGet download needed/allowed here. -->
    <Reference Include="Mono.Cecil">
      <HintPath>D:/SPT41/BepInEx/core/Mono.Cecil.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
