<!--
  Offline unit tests for the WP5 server mod — no live server required. Convention
  matches ArenaMode.Tests.csproj (xunit, net10.0, ProjectReference to the mod project).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- ArenaMapPort.Crypto uses unsafe pointer loops (docs/PLAN-ENCRYPTION.md D14) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- ServerStatusParser reads the status document with Newtonsoft.Json, the library EFT ships and the client already uses (13.0.1 on the host). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArenaMapPort.Server\ArenaMapPort.Server.csproj" />
    <Compile Include="..\ArenaMapPort.Client\RainExposurePolicy.cs" Link="Client\RainExposurePolicy.cs" />
    <Compile Include="..\ArenaMapPort.Client\DeveloperOptions.cs" Link="Client\DeveloperOptions.cs" />
    <Compile Include="..\ArenaMapPort.Client\PlayerOptions.cs" Link="Client\PlayerOptions.cs" />
    <Compile Include="..\ArenaMapPort.Client\AmbientAudioDefaults.cs" Link="Client\AmbientAudioDefaults.cs" />
    <Compile Include="..\ArenaMapPort.Client\RoomShotAcousticsModel.cs" Link="Client\RoomShotAcousticsModel.cs" />
    <Compile Include="..\ArenaMapPort.Client\AcousticVolumeRules.cs" Link="Client\AcousticVolumeRules.cs" />
    <Compile Include="..\ArenaMapPort.Client\SpawnGateModel.cs" Link="Client\SpawnGateModel.cs" />
    <Compile Include="..\ArenaMapPort.Client\PuddleCacheGate.cs" Link="Client\PuddleCacheGate.cs" />
    <!-- Native sea water (docs/progress/bay5-water.md, iceberg-release.md "native sea water"): the Unity-free rules of NativeWaterRepairs (one switch row per map with
         HasNativeWater, the package directory, the identity rule of water.json, the texture file name rule). NativeWaterRepairs.cs (WaterSSR types) stays out; NativeWaterTests reads it as text. -->
    <Compile Include="..\ArenaMapPort.Client\NativeWaterModel.cs" Link="Client\NativeWaterModel.cs" />
    <Compile Include="..\ArenaMapPort.Client\DoorPoseModel.cs" Link="Client\DoorPoseModel.cs" />
    <!-- Gate and door sounds (docs/progress/gate-sounds.md): the manifest, row matching, gain, seam pick and cut, and the WAV reader. No Unity type inside. -->
    <Compile Include="..\ArenaMapPort.Client\GateSoundModel.cs" Link="Client\GateSoundModel.cs" />
    <Compile Include="..\ArenaMapPort.Client\PcmWav.cs" Link="Client\PcmWav.cs" />
    <Compile Include="..\ArenaMapPort.Client\SpectatorAudioModel.cs" Link="Client\SpectatorAudioModel.cs" />
    <!-- The crowd murmur bed (docs/progress/spectator-audio.md "Crowd bed"): the Unity-free rules (stands by k-means, distance and volume laws, excitement smoothing, the manifest's bed)
         and the public SpectatorCrowd contract an ArenaMode binder finds by reflection. SpectatorCrowdBed.cs (AudioSource glue) stays out; SpectatorCrowdBedSourcePinTests reads it as text. -->
    <Compile Include="..\ArenaMapPort.Client\SpectatorCrowdBedModel.cs" Link="Client\SpectatorCrowdBedModel.cs" />
    <Compile Include="..\ArenaMapPort.Client\SpectatorCrowd.cs" Link="Client\SpectatorCrowd.cs" />
    <!-- The crowd's reactions (docs/PLAN-CROWD-REACTIONS.md): the claim and the request ring behind the four reaction members of SpectatorCrowd, the clip pool of the manifest's reaction set,
         the planner (coalescing, cooldowns, priority, voices, clip choice) and the speaker helper. No Unity type inside; SpectatorAudio.cs (voices, listener, playback) stays out. -->
    <Compile Include="..\ArenaMapPort.Client\CrowdReactionModel.cs" Link="Client\CrowdReactionModel.cs" />
    <!-- The roar layer of a reaction (docs/progress/spectator-audio.md "Roar beds"): the manifest's reaction_beds, the kind-to-bed table, the roar envelope, the clip picker and the volume law.
         No Unity type inside; SpectatorReactionBeds.cs (sources, clips, tick, keys) stays out; SpectatorReactionSourcePinTests reads it as text. -->
    <Compile Include="..\ArenaMapPort.Client\SpectatorReactionBedModel.cs" Link="Client\SpectatorReactionBedModel.cs" />
    <!-- The Unity-free half of the reactions' developer demo (Spectators/ReactionDemo): the step table of one pass, its cycle length and the runner that hands out the due step. The
         glue that claims, binds the keys and fires (SpectatorReactionDemo.cs) stays out; SpectatorReactionSourcePinTests reads it as text. -->
    <Compile Include="..\ArenaMapPort.Client\SpectatorReactionDemoPlan.cs" Link="Client\SpectatorReactionDemoPlan.cs" />
    <!-- The Unity-free core of the developer noise probe (docs/progress/spectator-audio.md "NoiseProbe diagnostic"): block statistics, burst detector, event ring, report text,
         self-test, PCM ring, WAV writer, capture policy. NoiseProbe.cs (config, taps, hotkey, census, export) stays out; NoiseProbeSourcePinTests reads it as text and brings a stand-in
         NoiseProbe for the linked PhysicsPropSoundRepairs.cs. -->
    <Compile Include="..\ArenaMapPort.Client\NoiseProbeModel.cs" Link="Client\NoiseProbeModel.cs" />
    <Compile Include="..\ArenaMapPort.Client\SpectatorTexturePackage.cs" Link="Client\SpectatorTexturePackage.cs" />
    <!-- Score monitors (docs/progress/score-monitors.md): the layout of the three faces (Arena's decoded template numbers, colours, sprite table). No Unity type inside. -->
    <Compile Include="..\ArenaMapPort.Client\ScoreMonitorLayout.cs" Link="Client\ScoreMonitorLayout.cs" />
    <!-- The Unity-free core of the monitor contract (docs/progress/score-monitors.md): the model (clamps, clock, frames, usable rows), the hub (claim semantics), the demo cycle and the public
         ScoreMonitors class an ArenaMode binder finds by reflection. ScoreMonitorView.cs (UGUI, TextMeshPro) stays out; ScoreMonitorSourcePinTests reads it as text. -->
    <Compile Include="..\ArenaMapPort.Client\ScoreMonitorModel.cs" Link="Client\ScoreMonitorModel.cs" />
    <Compile Include="..\ArenaMapPort.Client\ScoreMonitorHub.cs" Link="Client\ScoreMonitorHub.cs" />
    <Compile Include="..\ArenaMapPort.Client\ScoreMonitorDemo.cs" Link="Client\ScoreMonitorDemo.cs" />
    <Compile Include="..\ArenaMapPort.Client\ScoreMonitors.cs" Link="Client\ScoreMonitors.cs" />
    <Compile Include="..\ArenaMapPort.Client\AmbientAudioProfiles.cs" Link="Client\AmbientAudioProfiles.cs" />
    <Compile Include="..\ArenaMapPort.Client\DynamicMapAssets.cs" Link="Client\DynamicMapAssets.cs" />
    <Compile Include="..\ArenaMapPort.Shared\SpecularCapPolicy.cs" Link="Shared\SpecularCapPolicy.cs" />
    <Compile Include="..\ArenaMapPort.Client\ReflectiveSpecularRepairs.cs" Link="Client\ReflectiveSpecularRepairs.cs" />
    <Compile Include="..\ArenaMapPort.Client\DistantShadowCache.cs" Link="Client\DistantShadowCache.cs" />
    <Compile Include="..\ArenaMapPort.Client\ArenaMapRaid.cs" Link="Client\ArenaMapRaid.cs" />
    <Compile Include="..\ArenaMapPort.Client\PhysicsPropSoundRepairs.cs" Link="Client\PhysicsPropSoundRepairs.cs" />
    <Compile Include="..\ArenaMapPort.Client\DonorCameraSubscriptions.cs" Link="Client\DonorCameraSubscriptions.cs" />
    <Compile Include="..\ArenaMapPort.Client\RaidCoverBootstrap.cs" Link="Client\RaidCoverBootstrap.cs" />
    <Compile Include="..\ArenaMapPort.Client\ExfilNavMeshSampling.cs" Link="Client\ExfilNavMeshSampling.cs" />
    <Compile Include="..\ArenaMapPort.Client\IndoorSurfaceGeometry.cs" Link="Client\IndoorSurfaceGeometry.cs" />
    <Compile Include="..\ArenaMapPort.Client\FloorDetailSupport.cs" Link="Client\FloorDetailSupport.cs" />
    <Compile Include="..\ArenaMapPort.Client\FixedRaidTimeSelection.cs" Link="Client\FixedRaidTimeSelection.cs" />
    <Compile Include="..\ArenaMapPort.Client\TimeOfDayRepairs.cs" Link="Client\TimeOfDayRepairs.cs" />
    <Compile Include="..\ArenaMapPort.Client\WeatherTestOverride.cs" Link="Client\WeatherTestOverride.cs" />
    <Compile Include="..\ArenaMapPort.Client\EquatorProfiles.cs" Link="Client\EquatorProfiles.cs" />
    <Compile Include="..\ArenaMapPort.Client\EquatorProfileDefaults.cs" Link="Client\EquatorProfileDefaults.cs" />
    <Compile Include="..\ArenaMapPort.Client\MapConfigVisibility.cs" Link="Client\MapConfigVisibility.cs" />
    <Compile Include="..\ArenaMapPort.Client\SainLocationShim.cs" Link="Client\SainLocationShim.cs" />
    <Compile Include="..\ArenaMapPort.Client\AmbientBusLease.cs" Link="Client\AmbientBusLease.cs" />
    <Compile Include="..\ArenaMapPort.Client\ShaderStandinPolicy.cs" Link="Client\ShaderStandinPolicy.cs" />
    <!-- The per-map emission cap (docs/progress/iceberg-release.md "Per-map emission cap"): the shader-family rules, the scaling math and the ledger of originals with its
         idempotent apply and exact restore, over an interface the Unity glue implements. And the one-time bloom migration of Iceberg. No Unity type inside either;
         EmissionCapRepairs.cs (renderer scan, Material reads and writes) and BloomTuning.cs stay out, EmissionCapSourcePinTests reads them as text. -->
    <Compile Include="..\ArenaMapPort.Client\EmissionCapModel.cs" Link="Client\EmissionCapModel.cs" />
    <Compile Include="..\ArenaMapPort.Client\BloomDefaultsModel.cs" Link="Client\BloomDefaultsModel.cs" />
    <Compile Include="..\ArenaMapPort.Client\EmissionDefaultsModel.cs" Link="Client\EmissionDefaultsModel.cs" />
    <Compile Include="..\ArenaMapPort.Client\MapLightingDefaults.cs" Link="Client\MapLightingDefaults.cs" />
    <Compile Include="..\ArenaMapPort.Client\ArenaInstallationGate.cs" Link="Client\ArenaInstallationGate.cs" />
    <Compile Include="..\ArenaMapPort.Client\BundleKeyResolver.cs" Link="Client\BundleKeyResolver.cs" />
    <!-- The Unity-free core of the in-game map notices (docs/progress/map-notices.md): texts, input builder, selector, scheduler, failure registry, status parser.
         None of them may use Plugin.Log beyond the stub's four methods. -->
    <Compile Include="..\ArenaMapPort.Client\MapNoticeText.cs" Link="Client\MapNoticeText.cs" />
    <Compile Include="..\ArenaMapPort.Client\MapNoticeInputs.cs" Link="Client\MapNoticeInputs.cs" />
    <Compile Include="..\ArenaMapPort.Client\MapNoticeSelector.cs" Link="Client\MapNoticeSelector.cs" />
    <Compile Include="..\ArenaMapPort.Client\MapNoticeScheduler.cs" Link="Client\MapNoticeScheduler.cs" />
    <Compile Include="..\ArenaMapPort.Client\MapLoadFailures.cs" Link="Client\MapLoadFailures.cs" />
    <Compile Include="..\ArenaMapPort.Client\ServerStatusParser.cs" Link="Client\ServerStatusParser.cs" />
    <!-- Skipped Harmony targets (the HOOK_MISSING row) and the quiet status probe: both free of Unity and EFT. The probe reaches SPT's HTTP client by reflection;
         the tests bring a stand-in SPT.Common.Http.RequestHandler (ServerStatusClientTests). -->
    <Compile Include="..\ArenaMapPort.Client\SkippedHooks.cs" Link="Client\SkippedHooks.cs" />
    <Compile Include="..\ArenaMapPort.Client\ServerStatusClient.cs" Link="Client\ServerStatusClient.cs" />
    <!-- The same Crypto sources the client and the BundleCrypt tool compile, so the tests exercise the shipped code. -->
    <Compile Include="..\ArenaMapPort.Crypto\*.cs" Link="Crypto\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Referenced again here WITHOUT ExcludeAssets, matching ArenaMode.Tests.csproj's own
    note: the server project sets ExcludeAssets="runtime" because the live SPT process
    supplies these assemblies itself. A test host does not, so without this every test
    that touches an SPTarkov model type fails to load the assembly rather than failing
    an assertion.
  -->
  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Reflection" Version="4.1.5" />
  </ItemGroup>

  <!-- Per-map db files, copied so tests read the exact file the mod ships, not a duplicate. -->
  <ItemGroup>
    <Content Include="..\ArenaMapPort.Server\db\**\*.json" Link="db\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
