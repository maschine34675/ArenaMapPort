<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WP4 client plugin. Target framework and reference list per docs/SPEC.md §F.0/§B.WP4, verified against
    the sibling D:/SPT41/Development/ArenaMode/ArenaMode.Client/ArenaMode.Client.csproj which already
    builds and runs for this exact SPT 4.1 install: netstandard2.1 (Unity's Mono runtime accepts it even
    though vanilla net472 nominally doesn't fully implement that surface — a known, working convention,
    not a novel risk), same DLL set.

    O4 (deployment safety): unlike ArenaMode.Client.csproj's SPTClientDeploy target (which xcopies into
    $(SPTPath)\BepInEx\plugins\), this project's build output goes ONLY to D:/ArenaMapPort/dist/ — see the
    ArenaMapPortDistCopy target below. No target here writes into D:/SPT41 or X:/. Promoting dist/ into
    the live install is a separate, user-run, explicitly-approved step (decision #9 / O4).
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>maschine-ArenaMapPort.Client</AssemblyName>
    <RootNamespace>ArenaMapPort.Client</RootNamespace>
    <Description>ArenaMapPort client plugin - serves the Arena Equator location port (spike)</Description>
    <Company>https://github.com/maschine34675/ArenaMapPort</Company>
    <Authors>maschine</Authors>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug;Release</Configurations>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Read-only source of the game's Managed DLLs (O8). Never written to from this project. -->
    <EftManagedDir>D:/SPT41/EscapeFromTarkov_Data/Managed</EftManagedDir>

    <!-- O7/O4: build output lands under the repo's own dist/, never under D:/SPT41. -->
    <ArenaMapPortDistDir>$(MSBuildThisFileDirectory)..\dist\BepInEx\plugins\ArenaMapPort</ArenaMapPortDistDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- ArenaMode convention (ArenaMode.Client.csproj:19-26): link the shared source file directly
         rather than a project/binary reference, so client and server compile it independently. -->
    <Compile Include="..\ArenaMapPort.Shared\ArenaEquatorLocation.cs" Link="Shared\ArenaEquatorLocation.cs" />
    <Compile Include="..\ArenaMapPort.Shared\ArenaMapDescriptor.cs" Link="Shared\ArenaMapDescriptor.cs" />
    <Compile Include="..\ArenaMapPort.Shared\ArenaDustDescriptor.cs" Link="Shared\ArenaDustDescriptor.cs" />
    <Compile Include="..\ArenaMapPort.Shared\ArenaNeonFixture.cs" Link="Shared\ArenaNeonFixture.cs" />
    <Compile Include="..\ArenaMapPort.Shared\SpecularCapPolicy.cs" Link="Shared\SpecularCapPolicy.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(EftManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(EftManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(EftManagedDir)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort.Unity">
      <HintPath>$(EftManagedDir)\Comfort.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(EftManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(EftManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(EftManagedDir)\Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(EftManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(EftManagedDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(EftManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- NavMesh.AddNavMeshData / NavMeshData (§F.2) -->
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(EftManagedDir)\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(EftManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AssetBundle / AssetBundle.LoadFromFile (§F.1/§F.2) -->
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(EftManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(EftManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(EftManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(EftManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(EftManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(EftManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(EftManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(EftManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(EftManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(EftManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- PLAN-TWO-MAPS item 10b: ImageConversion.LoadImage decodes the plugin-local loading-screen
         JPEGs (see LoadingScreenArt.cs). UnityWebRequestTextureModule is deliberately NOT added —
         the art ships as plugin-local files, never fetched over HTTP. -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(EftManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- donor-settings-camera-weather §B: LevelSettings.PostProcessProfilePrefab's type
         (UnityEngine.Rendering.PostProcessing.PostProcessProfile) lives in its own managed DLL, not
         Assembly-CSharp — PrismPreset (Prism.Utils) is a BSG type and needs no extra reference. -->
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>$(EftManagedDir)\Unity.Postprocessing.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
  </ItemGroup>

  <!-- O4/O7: copy the built DLL into dist/ only. No target in this file ever references $(SPTPath) or
       any path under D:/SPT41 or X:/ as a WRITE destination. -->
  <Target Name="ArenaMapPortDistCopy" AfterTargets="PostBuildEvent" Condition="'$(Configuration)'=='Release'">
    <MakeDir Directories="$(ArenaMapPortDistDir)" Condition="!Exists('$(ArenaMapPortDistDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ArenaMapPortDistDir)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="[ArenaMapPort] deployed $(TargetFileName) -&gt; $(ArenaMapPortDistDir)" />
  </Target>

  <!-- Curated Arena announcer/ambience/stinger audio, extracted read-only from the user's Arena/EFT
       installs and transcoded to OGG Vorbis (tools/extract/extract_arena_audio.py). ArenaMapPort itself
       never plays any of this — it only stages it into its own deployed plugin folder so ArenaMode
       (D:/SPT41/Development/ArenaMode, a separate mod) can optionally pick it up as an additional/
       alternate announcer source. See docs/progress/arena-audio.md for the manifest.json contract this
       staged folder is. Unlike the BSG-derived staging targets above/below, a missing input here is NOT
       a build error — this data is optional and nothing in this project depends on it. -->
  <Target Name="ArenaMapPortStageArenaAudio" AfterTargets="ArenaMapPortDistCopy" Condition="'$(Configuration)'=='Release'">
    <PropertyGroup>
      <ArenaMapPortAudioDir>$(MSBuildThisFileDirectory)..\work\extract\arena-audio</ArenaMapPortAudioDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(ArenaMapPortAudioDir)\manifest.json')">
      <ArenaMapPortAudioFile Include="$(ArenaMapPortAudioDir)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ArenaMapPortAudioFile)"
          DestinationFiles="@(ArenaMapPortAudioFile->'$(ArenaMapPortDistDir)\arena-audio\%(RecursiveDir)%(Filename)%(Extension)')"
          Condition="Exists('$(ArenaMapPortAudioDir)\manifest.json')" SkipUnchangedFiles="true" />
    <Message Importance="high" Condition="Exists('$(ArenaMapPortAudioDir)\manifest.json')"
             Text="[ArenaMapPort] staged Arena audio (optional, for ArenaMode) from $(ArenaMapPortAudioDir) into dist/.../arena-audio/" />
    <Message Importance="high" Condition="!Exists('$(ArenaMapPortAudioDir)\manifest.json')"
             Text="[ArenaMapPort] no Arena audio to stage ($(ArenaMapPortAudioDir)\manifest.json not found) - run tools/extract/extract_arena_audio.py if ArenaMode should get it; ArenaMapPort itself does not use these files" />
  </Target>

  <!-- Curated Arena UI sprites/textures (killfeed icons, K/D/A glyphs, mode-select logos, kit-class
       medallions, capture-point progress/marker art, scoreboard row backgrounds + team-color palette, an
       animated MVP medal), extracted read-only from the user's own Arena install as plain RGBA PNGs
       (tools/extract/extract_arena_ui.py). Same optional-staging contract as ArenaMapPortStageArenaAudio
       just above: ArenaMapPort itself never displays any of this, it only stages it into its own deployed
       plugin folder so ArenaMode (a separate mod) can optionally pick any of it up. See
       docs/progress/arena-ui.md for the manifest.json contract this staged folder is. previews/ (contact
       sheets for a human to eyeball, not consumed by any code) is deliberately excluded, never staged.
       A missing input here is NOT a build error, same reasoning as the audio target: this data is
       optional and nothing in this project depends on it. -->
  <Target Name="ArenaMapPortStageArenaUi" AfterTargets="ArenaMapPortDistCopy" Condition="'$(Configuration)'=='Release'">
    <PropertyGroup>
      <ArenaMapPortUiDir>$(MSBuildThisFileDirectory)..\work\extract\arena-ui</ArenaMapPortUiDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(ArenaMapPortUiDir)\manifest.json')">
      <ArenaMapPortUiFile Include="$(ArenaMapPortUiDir)\**\*.*" Exclude="$(ArenaMapPortUiDir)\previews\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ArenaMapPortUiFile)"
          DestinationFiles="@(ArenaMapPortUiFile->'$(ArenaMapPortDistDir)\arena-ui\%(RecursiveDir)%(Filename)%(Extension)')"
          Condition="Exists('$(ArenaMapPortUiDir)\manifest.json')" SkipUnchangedFiles="true" />
    <Message Importance="high" Condition="Exists('$(ArenaMapPortUiDir)\manifest.json')"
             Text="[ArenaMapPort] staged Arena UI sprites (optional, for ArenaMode) from $(ArenaMapPortUiDir) into dist/.../arena-ui/" />
    <Message Importance="high" Condition="!Exists('$(ArenaMapPortUiDir)\manifest.json')"
             Text="[ArenaMapPort] no Arena UI sprites to stage ($(ArenaMapPortUiDir)\manifest.json not found) - run tools/extract/extract_arena_ui.py if ArenaMode should get it; ArenaMapPort itself does not use these files" />
  </Target>

  <!-- PLAN-TWO-MAPS item 8: AiAnchors.cs reads <plugin>/ai/<key>.ai.json at raid start. The sidecars are
       git-tracked (tools/maps/*.ai.json, written by tools/extract/extract_ai_anchors.py), so they are staged
       with the DLL on every Release build, DllOnly included. -->
  <Target Name="ArenaMapPortStageAiSidecars" AfterTargets="ArenaMapPortDistCopy" Condition="'$(Configuration)'=='Release'">
    <ItemGroup>
      <ArenaMapPortAiSidecar Include="$(MSBuildThisFileDirectory)..\tools\maps\equator.ai.json" />
      <ArenaMapPortAiSidecar Include="$(MSBuildThisFileDirectory)..\tools\maps\bay5.ai.json" />
    </ItemGroup>
    <Error Condition="!Exists('%(ArenaMapPortAiSidecar.Identity)')" Text="[ArenaMapPort] missing AI sidecar %(ArenaMapPortAiSidecar.Identity)" />
    <MakeDir Directories="$(ArenaMapPortDistDir)\ai" />
    <Copy SourceFiles="@(ArenaMapPortAiSidecar)" DestinationFolder="$(ArenaMapPortDistDir)\ai" SkipUnchangedFiles="false" />
  </Target>

  <!-- Original acoustic graph, bake and room tones; generated from the user's Arena install.
       Source-derived data stays in ignored work/dist and is staged without a scene rebuild. -->
  <Target Name="ArenaMapPortStageAcoustics" AfterTargets="ArenaMapPortDistCopy" Condition="'$(Configuration)'=='Release'">
    <PropertyGroup>
      <ArenaMapPortAcousticsDir>$(MSBuildThisFileDirectory)..\work\extract\spatial-audio</ArenaMapPortAcousticsDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(ArenaMapPortAcousticsDir)\arena_equator\spatial-audio.json') Or !Exists('$(ArenaMapPortAcousticsDir)\arena_bay5\spatial-audio.json')"
           Text="Missing native acoustic input; run tools/extract/extract_spatial_audio.py" />
    <ItemGroup>
      <ArenaMapPortAcousticFile Include="$(ArenaMapPortAcousticsDir)\arena_equator\**\spatial-audio.json;$(ArenaMapPortAcousticsDir)\arena_equator\**\source.audiobakedata;$(ArenaMapPortAcousticsDir)\arena_equator\**\*.wav"><MapKey>arena_equator</MapKey></ArenaMapPortAcousticFile>
      <ArenaMapPortAcousticFile Include="$(ArenaMapPortAcousticsDir)\arena_bay5\**\spatial-audio.json;$(ArenaMapPortAcousticsDir)\arena_bay5\**\source.audiobakedata;$(ArenaMapPortAcousticsDir)\arena_bay5\**\*.wav"><MapKey>arena_bay5</MapKey></ArenaMapPortAcousticFile>
    </ItemGroup>
    <Copy SourceFiles="@(ArenaMapPortAcousticFile)" DestinationFiles="@(ArenaMapPortAcousticFile->'$(ArenaMapPortDistDir)\acoustics\%(MapKey)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- Original map flares and raw source atlas; isolated native renderer, no scene rebuild. -->
  <Target Name="ArenaMapPortStageMultiFlare" AfterTargets="ArenaMapPortDistCopy" Condition="'$(Configuration)'=='Release'">
    <PropertyGroup>
      <ArenaMapPortFlareDir>$(MSBuildThisFileDirectory)..\work\extract\multiflare</ArenaMapPortFlareDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(ArenaMapPortFlareDir)\arena_equator\flares.json') Or !Exists('$(ArenaMapPortFlareDir)\arena_bay5\flares.json')"
           Text="Missing original flare input; run tools/extract/extract_multiflare.py" />
    <ItemGroup>
      <ArenaMapPortFlareFile Include="$(ArenaMapPortFlareDir)\arena_equator\flares.json;$(ArenaMapPortFlareDir)\arena_equator\textures\*.bin">
        <MapKey>arena_equator</MapKey>
      </ArenaMapPortFlareFile>
      <ArenaMapPortFlareFile Include="$(ArenaMapPortFlareDir)\arena_bay5\flares.json;$(ArenaMapPortFlareDir)\arena_bay5\textures\*.bin">
        <MapKey>arena_bay5</MapKey>
      </ArenaMapPortFlareFile>
    </ItemGroup>
    <Copy SourceFiles="@(ArenaMapPortFlareFile)" DestinationFiles="@(ArenaMapPortFlareFile->'$(ArenaMapPortDistDir)\flares\%(MapKey)\%(Filename)%(Extension)')" Condition="'%(ArenaMapPortFlareFile.Extension)'=='.json'" />
    <Copy SourceFiles="@(ArenaMapPortFlareFile)" DestinationFiles="@(ArenaMapPortFlareFile->'$(ArenaMapPortDistDir)\flares\%(MapKey)\textures\%(Filename)%(Extension)')" Condition="'%(ArenaMapPortFlareFile.Extension)'=='.bin'" />
  </Target>

  <!-- Original native water settings and raw mip chains; generated from the user's Arena install. -->
  <Target Name="ArenaMapPortStageWater" AfterTargets="ArenaMapPortDistCopy" Condition="'$(Configuration)'=='Release'">
    <PropertyGroup>
      <ArenaMapPortWaterDir>$(MSBuildThisFileDirectory)..\work\extract\bay5-water</ArenaMapPortWaterDir>
    </PropertyGroup>
    <ItemGroup>
      <ArenaMapPortWaterFile Include="$(ArenaMapPortWaterDir)\water.json" />
      <ArenaMapPortWaterFile Include="$(ArenaMapPortWaterDir)\textures\foam.bin;$(ArenaMapPortWaterDir)\textures\normals.bin;$(ArenaMapPortWaterDir)\textures\normalsDetails.bin;$(ArenaMapPortWaterDir)\textures\rippleTexture.bin" />
    </ItemGroup>
    <Error Condition="!Exists('%(ArenaMapPortWaterFile.Identity)')" Text="Missing native water input %(ArenaMapPortWaterFile.Identity); run tools/extract/extract_water.py" />
    <Copy SourceFiles="$(ArenaMapPortWaterDir)\water.json" DestinationFolder="$(ArenaMapPortDistDir)\water\arena_bay5" />
    <Copy SourceFiles="$(ArenaMapPortWaterDir)\textures\foam.bin;$(ArenaMapPortWaterDir)\textures\normals.bin;$(ArenaMapPortWaterDir)\textures\normalsDetails.bin;$(ArenaMapPortWaterDir)\textures\rippleTexture.bin" DestinationFolder="$(ArenaMapPortDistDir)\water\arena_bay5\textures" />
  </Target>

  <!--
    §B.WP2.8's own words: "Output written to work/build/ ..., then copied into
    dist/BepInEx/plugins/ArenaMapPort/bundles/ by a deploy step WP4 owns." This is that step, run after
    every Release build. Still O4/O7-safe (work/ and dist/ only).

    S3 FIX (dist-manifest pass): this used to be a recursive `work\build\**\*.bundle` glob (minus
    `_donor_*`) — which also matches `work/build/s1/arena_equator_scenes.bundle` and
    `work/build/s1/arena_equator_navmesh.bundle` (SAME filenames as the full build's, since both were
    built by the same BuildBundles.Run). MSBuild's glob enumeration order is filesystem-dependent, not
    guaranteed path-sorted, so which one last-writes to dist/.../bundles/<name>.bundle was
    non-deterministic — the exact "never S1/stale ones" risk this pass exists to close. Fixed: name the
    THREE known-good source files explicitly (full build's 2 scene/navmesh bundles + WP3's one preset
    bundle) instead of globbing the whole work/build/ tree. A missing expected file is a build-time
    error (below), not a silent skip; nothing under work/build/s1*/work/build/s1_diag/ is ever
    considered.
  -->
  <!-- Client-only iteration: "dotnet build -c Release -p:ArenaMapPortDllOnly=true" copies just the DLL
       to dist and skips bundle staging. -->
  <Target Name="ArenaMapPortStageWpOutputs" AfterTargets="ArenaMapPortDistCopy" Condition="'$(Configuration)'=='Release' And '$(ArenaMapPortDllOnly)'!='true'">
    <PropertyGroup>
      <ArenaMapPortFullBuildDir>$(MSBuildThisFileDirectory)..\work\build\full</ArenaMapPortFullBuildDir>
      <ArenaMapPortPresetBuildDir>$(MSBuildThisFileDirectory)..\work\build\preset</ArenaMapPortPresetBuildDir>
      <!-- Multimap generalization (docs/progress/multimap-generalize.md, docs/progress/bay5-port.md):
           Bay5's own tools/build_all.ps1 -MapKey arena_bay5 -OutputDir output, separate from
           Equator's work/build/full (its own explicit list stays Equator-only, unchanged; see
           below). Bay5's preset bundle lands in the SAME shared work/build/preset dir Equator's
           does (patch_preset.py's own output default is work/build/preset/<key>_preset.bundle). -->
      <ArenaMapPortBay5BuildDir>$(MSBuildThisFileDirectory)..\work\build\bay5</ArenaMapPortBay5BuildDir>
    </PropertyGroup>
    <ItemGroup>
      <ArenaMapPortBundles Include="$(ArenaMapPortFullBuildDir)\arena_equator_scenes.bundle" />
      <ArenaMapPortBundles Include="$(ArenaMapPortFullBuildDir)\arena_equator_navmesh.bundle" />
      <ArenaMapPortBundles Include="$(ArenaMapPortPresetBuildDir)\arena_equator_preset.bundle" />
      <ArenaMapPortShaderSidecar Include="$(ArenaMapPortFullBuildDir)\material-shaders.json" />
      <!-- Bay5, kept as its own explicit list rather than folded into the two ItemGroups above or
           switched to a wildcard: dist-manifest.md's "exactly N expected files" invariant is a
           real, already-relied-on regression check (docs/progress/multimap-generalize.md SS8 note
           2/SS9 item 5); an explicit per-map list keeps that check meaningful for each map
           independently instead of silently accepting a stray leftover .bundle file. -->
      <ArenaMapPortBundles Include="$(ArenaMapPortBay5BuildDir)\arena_bay5_scenes.bundle" />
      <ArenaMapPortBundles Include="$(ArenaMapPortBay5BuildDir)\arena_bay5_navmesh.bundle" />
      <ArenaMapPortBundles Include="$(ArenaMapPortPresetBuildDir)\arena_bay5_preset.bundle" />
      <!-- ShaderRebind.SidecarFileName: Equator keeps its pre-generalization "material-shaders.json"
           (already deployed under that exact name); every other map gets its own
           "material-shaders.<map.Key>.json". Bay5's map.Key is "arena_bay5", not the short "bay5"
           tools/maps/ file stem, so the staged/renamed dist filename below must match that exactly. -->
      <ArenaMapPortBay5ShaderSidecarSrc Include="$(ArenaMapPortBay5BuildDir)\material-shaders.json" />
    </ItemGroup>
    <Error Text="[ArenaMapPort] expected bundle missing: %(ArenaMapPortBundles.Identity) -- run tools/build_all.ps1 (full, and -MapKey arena_bay5) and tools/preset/patch_preset.py (both maps) first"
           Condition="!Exists('%(ArenaMapPortBundles.Identity)')" />
    <Error Text="[ArenaMapPort] expected material-shaders.json missing: %(ArenaMapPortShaderSidecar.Identity)"
           Condition="!Exists('%(ArenaMapPortShaderSidecar.Identity)')" />
    <Error Text="[ArenaMapPort] expected Bay5 material-shaders.json missing: %(ArenaMapPortBay5ShaderSidecarSrc.Identity) -- run tools/build_all.ps1 -MapKey arena_bay5 first"
           Condition="!Exists('%(ArenaMapPortBay5ShaderSidecarSrc.Identity)')" />
    <MakeDir Directories="$(ArenaMapPortDistDir)\bundles" />
    <Copy SourceFiles="@(ArenaMapPortBundles)" DestinationFolder="$(ArenaMapPortDistDir)\bundles" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(ArenaMapPortShaderSidecar)" DestinationFolder="$(ArenaMapPortDistDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(ArenaMapPortBay5ShaderSidecarSrc)" DestinationFiles="$(ArenaMapPortDistDir)\material-shaders.arena_bay5.json" SkipUnchangedFiles="false" />
    <Message Importance="high"
             Text="[ArenaMapPort] staged %(ArenaMapPortBundles.Filename)%(ArenaMapPortBundles.Extension) from $(ArenaMapPortFullBuildDir)/$(ArenaMapPortPresetBuildDir)/$(ArenaMapPortBay5BuildDir) into dist/.../bundles/" />
    <Message Importance="high" Text="[ArenaMapPort] staged material-shaders.json from $(ArenaMapPortFullBuildDir) into dist/.../ArenaMapPort/" />
    <Message Importance="high" Text="[ArenaMapPort] staged material-shaders.arena_bay5.json from $(ArenaMapPortBay5BuildDir) into dist/.../ArenaMapPort/" />
  </Target>

  <!-- Parked map outputs remain recoverable under work; they never enter this release. -->
  <Target Name="ArenaMapPortParkUnreleased" BeforeTargets="ArenaMapPortDistCopy" Condition="'$(Configuration)'=='Release'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\tools\park-unreleased-dist.ps1&quot; -Scope Client" />
  </Target>
</Project>
