<?xml version="1.0" encoding="utf-8"?>
<!-- BepInEx.Core/BepInEx.PluginInfoProps/BepInEx.Analyzers are published to nuget.bepinex.dev, not
     nuget.org (same source ArenaMode's own NuGet.Config uses, D:/SPT41/Development/ArenaMode/NuGet.Config).
     All packages this project needs were already restored into the shared NuGet cache by that sibling
     project's own builds, so this file is mostly belt-and-braces for a from-scratch restore. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
